# Convex Cloud deployment URL; inlined at build time. Required in real mode.
NEXT_PUBLIC_CONVEX_URL=
# Optional HTTP actions origin override for local binary previews.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Optional workspace to open after sign-in instead of workspace lookup.
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=
# true uses in-memory data and a fake session; use false for shared data.
NEXT_PUBLIC_USE_MOCKS=true
