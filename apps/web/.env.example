# Convex deployment URL (Person 2). Inlined at build time.
NEXT_PUBLIC_CONVEX_URL=
# Optional: skip workspace lookup and open this workspace after sign-in.
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=
# true = in-memory mock backend + fake session (no Convex needed).
NEXT_PUBLIC_USE_MOCKS=true

# Optional HTTP actions host override (local Convex normally uses the next port).
# NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3213
