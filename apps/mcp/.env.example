PORT=8787
# Interface to bind. Localhost by default; use 0.0.0.0 only inside a container.
HOST=127.0.0.1
TANDEM_BACKEND=mock
# key:user_id pairs. Generate each key with: openssl rand -hex 24
TANDEM_DEV_TOKENS=<key-for-alex>:user_alex,<key-for-sam>:user_sam
# Comma-separated browser origins allowed to call /mcp (e.g. http://localhost:6274 for MCP Inspector).
# Requests that carry any other Origin get 403; requests with no Origin are unaffected.
TANDEM_ALLOWED_ORIGINS=
# TEMPORARY, mock backend + NODE_ENV=development or test only: requests with no api-key header act as this user.
# `pnpm --filter mcp dev` sets NODE_ENV=development.
# TANDEM_DEV_ANON_USER=user_alex
